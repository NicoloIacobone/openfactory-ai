<?xml version="1.0" encoding="UTF-8"?>
<!-- Vendor UR SRDF (groups, named states, arm self-collision matrix) plus the gripper and the
     cell fixtures. The robot name matches the URDF from openfactory_description. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf/>

  <!-- Gripper: the fingers are commanded through gripper_controller, not planned with the arm -->
  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.0425"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.0"/>
  </group_state>
  <end_effector name="gripper" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>

  <!-- The palm sits on the flange; the fingers slide on the palm and touch each other when closed -->
  <disable_collisions link1="gripper_palm" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="right_finger" reason="Adjacent"/>
  <disable_collisions link1="left_finger" link2="right_finger" reason="Default"/>
  <disable_collisions link1="left_finger" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="right_finger" link2="wrist_3_link" reason="Never"/>

  <!-- The base sits on the table; the shoulder only turns about the table normal above it;
       the table stands on the floor -->
  <disable_collisions link1="table" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="table" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="floor" link2="table" reason="Adjacent"/>
  <disable_collisions link1="floor" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="floor" link2="shoulder_link" reason="Never"/>
  <!-- The bins stand on the table; fixtures never move relative to each other -->
  <disable_collisions link1="input_bin" link2="table" reason="Adjacent"/>
  <disable_collisions link1="output_bin" link2="table" reason="Adjacent"/>
  <disable_collisions link1="input_bin" link2="floor" reason="Never"/>
  <disable_collisions link1="output_bin" link2="floor" reason="Never"/>
  <disable_collisions link1="input_bin" link2="output_bin" reason="Never"/>
  <disable_collisions link1="input_bin" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="output_bin" link2="base_link_inertia" reason="Never"/>
  <!-- The camera hangs above the input bin, out of reach of the base and the shoulder -->
  <disable_collisions link1="camera_link" link2="table" reason="Never"/>
  <disable_collisions link1="camera_link" link2="floor" reason="Never"/>
  <disable_collisions link1="camera_link" link2="input_bin" reason="Never"/>
  <disable_collisions link1="camera_link" link2="output_bin" reason="Never"/>
  <disable_collisions link1="camera_link" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="camera_link" link2="shoulder_link" reason="Never"/>
</robot>
